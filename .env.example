# LLM Provider API Keys (configure the provider you plan to use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM Configuration (Ollama / vLLM)
OLLAMA_BASE_URL=http://localhost:11434

# Runtime Guardrails & Sandbox Settings
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_SECONDS=30
AGENT_SANDBOX_ROOT=./sandbox_workspace

# Infrastructure (used by docker-compose.yml)
DATABASE_URL=postgresql://agent_admin:secure_pass_123@postgres:5432/agent_db
REDIS_URL=redis://redis:6379/0
